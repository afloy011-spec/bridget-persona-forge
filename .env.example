# Скопировать в .env или выставить в оболочке. Больше переменных нет —
# прежняя редакция этого файла просила четыре ключа к сервисам
# AI-детекции для ворот, которых в коде не существует.

# Адрес ComfyUI. Обязателен для всего, что генерирует. Альтернатива —
# файл assets.local.json рядом с assets.json: {"host": "http://...:8188"}.
# В отслеживаемом манифесте адреса нет намеренно.
COMFY_HOST=http://127.0.0.1:8188

# Куда складывать кадры, реестры и вердикты. ВНЕ дерева репозитория:
# это гигабайты PNG. Без переменной берётся paths.work_root из assets.json.
PERSONA_WORK_ROOT=../persona-forge-work
