__pycache__/
*.py[cod]

# Реестр заливок на сервер — состояние конкретной машины, не код.
.uploads.json

# Адрес воркера и прочее, что относится к конкретной машине, а не к проекту.
assets.local.json

# Кадры, вердикты и промежутки конвейера живут в work_root вне репозитория
# (см. assets.json → paths.work_root). Если work_root когда-нибудь окажется
# внутри дерева — не тащить его в историю: это гигабайты PNG.
work/
frames/
**/frames/**

# СДАВАЕМЫЕ ФАЙЛЫ ОСТАЮТСЯ В РЕПОЗИТОРИИ. Раньше здесь стояли *.png/*.jpg/
# *.jpeg — то есть репозиторий по собственной конфигурации не мог донести до
# ревьюера ровно то, ради чего он существует: сами фотографии. `git add .`
# молча пропускал папку с готовыми кадрами.
!deliverables/**
!assets/**
!docs/**

.DS_Store
Thumbs.db
.scrub-patterns.local
